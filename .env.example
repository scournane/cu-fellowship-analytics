# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is gitignored; .env.example is committed.
# Nothing in this file is a real secret.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# The DSN printed by `supabase start`. This is the default local stack.
CUFA_DATABASE_URL=postgresql://postgres:postgres@localhost:64322/postgres

# --- Encryption at rest ---------------------------------------------------
# Fernet key used to encrypt the Google refresh token before it is stored.
# Generate one with:  python -m cufa.crypto keygen
# If unset, `cufa google connect` refuses to store a token.
CUFA_ENCRYPTION_KEY=

# --- Console --------------------------------------------------------------
# Comma-separated allowlist of CU staff who may sign into the console.
CUFA_CONSOLE_ALLOWLIST=staff@civicsunplugged.org
# Who may open the Help requests screen. A SUBSET of the list above, and a
# separate one on purpose: a record that a fellow asked to be checked in with is
# not routine operational data. Leave it blank to fall back to whoever is named
# in config/help_routing.json — the people already receiving the emails.
CUFA_HELP_ALLOWLIST=
# Random string used to sign the console's session cookie.
CUFA_CONSOLE_SECRET=change-me-to-a-random-string
CUFA_CONSOLE_HOST=127.0.0.1
CUFA_CONSOLE_PORT=8000

# --- Google OAuth ---------------------------------------------------------
# From the OAuth client you create in Google Cloud. See docs/setup/google-cloud.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/google/callback

# Set to 1 to run the console and CLI against FakeGoogleClient (no network).
# `make demo` and `make demo-console` set this for you.
CUFA_FAKE_GOOGLE=0

# --- Gemini (tier 2 adjudication) ----------------------------------------
# Optional. Without it the pipeline still completes; mismatch cases land in
# needs_review with rule_name='ai_unavailable'.
GEMINI_API_KEY=
CUFA_AI_MODEL=gemini-2.5-flash
CUFA_AI_MAX_CALLS_PER_RUN=250

# --- Adjudication tuning --------------------------------------------------
CUFA_MAX_EDIT_DISTANCE=1

# --- Logging --------------------------------------------------------------
# DEBUG is the only level at which raw email addresses are emitted.
CUFA_LOG_LEVEL=INFO
